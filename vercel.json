{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend-node/server.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/backend-node/uploads/$1"
    },
    {
      "source": "/(.*s)",
      "destination": "/frontend/$1"
    }
  ],
  "builds": [
    {
      "src": "backend-node/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ]
}
